% Copy this file to config.m and replace both paths with absolute paths.

neuro_root = '/absolute/path/to/neuro-code-nwc';
oppni_code_root = '/absolute/path/to/oppni-code-nwc';
if ~isfolder(neuro_root) || ~isfolder(oppni_code_root)
    error('Update neuro_root and oppni_code_root to existing absolute paths.');
end

% Set AFNI_BIN if AFNI is not already available through the login profile/module.
afni_bin = getenv('AFNI_BIN');
if ~isempty(afni_bin)
    setenv('PATH', [afni_bin ':' getenv('PATH')]);
end

addpath(genpath(neuro_root));
addpath(genpath(oppni_code_root));
